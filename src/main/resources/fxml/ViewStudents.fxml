<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uqu.sgm.controllers.ViewStudentsController"
      spacing="12.0" styleClass="root-pane">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <Label styleClass="title-label" text="All Students"/>

    <TableView fx:id="studentsTable" prefHeight="220.0" onMouseClicked="#showGrades">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="140.0" text="ID"/>
            <TableColumn fx:id="nameColumn" prefWidth="260.0" text="Name"/>
            <TableColumn fx:id="averageColumn" prefWidth="120.0" text="Average"/>
        </columns>
    </TableView>

    <Label styleClass="subtitle-label" text="Grades of selected student:"/>
    <ListView fx:id="gradesList" prefHeight="140.0"/>

    <Button onAction="#goBack" styleClass="secondary-button" text="Back to Dashboard"/>
</VBox>
