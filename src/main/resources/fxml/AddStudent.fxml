<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uqu.sgm.controllers.AddStudentController"
      alignment="CENTER" spacing="15.0" styleClass="root-pane">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label styleClass="title-label" text="Add Student"/>

    <TextField fx:id="idField" maxWidth="250.0" promptText="Student ID"/>
    <TextField fx:id="nameField" maxWidth="250.0" promptText="Student Name"/>

    <Button onAction="#handleAdd" styleClass="primary-button" text="Add Student"/>
    <Label fx:id="messageLabel" styleClass="info-label"/>

    <Button onAction="#goBack" styleClass="secondary-button" text="Back to Dashboard"/>
</VBox>
