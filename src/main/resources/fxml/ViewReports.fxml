<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uqu.sgm.controllers.ViewReportsController"
      spacing="12.0" styleClass="root-pane">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <Label styleClass="title-label" text="Reports"/>

    <TextArea fx:id="reportArea" editable="false" prefHeight="340.0" wrapText="true"/>

    <Button onAction="#goBack" styleClass="secondary-button" text="Back to Dashboard"/>
</VBox>
