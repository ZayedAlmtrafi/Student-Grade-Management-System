<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uqu.sgm.controllers.DashboardController"
      alignment="CENTER" spacing="15.0" styleClass="root-pane">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label styleClass="title-label" text="Dashboard"/>
    <Label styleClass="subtitle-label" text="Select an option"/>

    <Button maxWidth="220.0" onAction="#goAddStudent" styleClass="menu-button" text="Add Student"/>
    <Button maxWidth="220.0" onAction="#goAddGrades" styleClass="menu-button" text="Add Grades"/>
    <Button maxWidth="220.0" onAction="#goViewStudents" styleClass="menu-button" text="View Students"/>
    <Button maxWidth="220.0" onAction="#goViewReports" styleClass="menu-button" text="View Reports"/>
    <Button maxWidth="220.0" onAction="#logout" styleClass="secondary-button" text="Logout"/>
</VBox>
