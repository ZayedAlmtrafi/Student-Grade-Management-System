<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uqu.sgm.controllers.AddGradesController"
      alignment="CENTER" spacing="15.0" styleClass="root-pane">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label styleClass="title-label" text="Add Grades"/>

    <ComboBox fx:id="studentCombo" maxWidth="250.0" promptText="Select Student"/>
    <TextField fx:id="subjectField" maxWidth="250.0" promptText="Subject"/>
    <TextField fx:id="scoreField" maxWidth="250.0" promptText="Score (0-100)"/>

    <Button onAction="#handleAdd" styleClass="primary-button" text="Add Grade"/>
    <Label fx:id="messageLabel" styleClass="info-label"/>

    <Button onAction="#goBack" styleClass="secondary-button" text="Back to Dashboard"/>
</VBox>
